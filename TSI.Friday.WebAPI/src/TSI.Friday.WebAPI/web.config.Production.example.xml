<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelo de referência para o web.config publicado no servidor de produção/homolog.

  Como usar:
  1. Copie este arquivo para "web.config.Production.xml" (esse nome está no
     .gitignore, então nunca será commitado).
  2. Preencha os valores reais abaixo.
  3. Depois de cada deploy via FTP, sobrescreva o web.config publicado no
     servidor com o conteúdo deste arquivo preenchido, ao invés de subir o
     web.config gerado pelo build (que não tem nenhum segredo).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add
        name="aspNetCore"
        path="*"
        verb="*"
        modules="AspNetCoreModuleV2"
        resourceType="Unspecified"
      />
    </handlers>

    <aspNetCore
      processPath=".\TSI.Friday.WebAPI.exe"
      arguments=""
      stdoutLogEnabled="false"
      stdoutLogFile=".\stdout"
      hostingModel="OutOfProcess"
    >
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=SEU_HOST;port=3306;Database=SEU_DB;Uid=SEU_USER;Pwd=SUA_SENHA;" />
        <environmentVariable name="ConnectionStrings__HomologConnection" value="Server=SEU_HOST;port=3306;Database=SEU_DB_HOMOLOG;Uid=SEU_USER;Pwd=SUA_SENHA;" />
        <environmentVariable name="JWT__Key" value="SUA_CHAVE_JWT" />
        <environmentVariable name="MailJet__ApiKey" value="SUA_MAILJET_API_KEY" />
        <environmentVariable name="MailJet__SecretKey" value="SUA_MAILJET_SECRET_KEY" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>

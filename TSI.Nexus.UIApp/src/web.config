<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- NÃO reescrever para arquivos estáticos -->
            <add input="{REQUEST_URI}" pattern="^/(.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- enabled="true" is required, not just decorative: some hosts (this one included) turn off
         Default Document at the server/site level, and without the explicit override here a bare
         "/" request (no filename, so our rewrite rule above skips it - see its IsDirectory
         condition) falls through to whatever that host serves by default instead of index.html. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- IIS has no default MIME mapping for .webmanifest, so it 404s (404.3) without this. -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>